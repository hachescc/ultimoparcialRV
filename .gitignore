/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Proyectos de IDE generados por Unity (cada uno los regenera)
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/

# Metas de archivos pdb/mdb de Unity
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Crash reports y builds
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
*.app

# Archivos de streaming generados por Addressables / Burst
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*
*_BurstDebugInformation_DoNotShip/

# ===================== Sistema operativo =====================
.DS_Store
Thumbs.db
Desktop.ini

# ===================== Material de trabajo que NO es del juego =====================
# Documentacion: PDF/web/capturas/video del recorrido y PNGs de comparacion (se regeneran, ver CLAUDE.md)
/Documentacion/
*.mp4

# Modelos originales descargados (~600 MB, sin optimizar). El juego usa las versiones
# procesadas de Assets/_RickMorty/Models. Solo se sube el archivo de creditos/licencias.
/_ModelosOriginales/**
!/_ModelosOriginales/**/
!/_ModelosOriginales/**/*.md

# Configuracion local de herramientas del editor
/.claude/
